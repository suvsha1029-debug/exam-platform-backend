<Window x:Class="MasterAdmin.ExamLobby.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Master Admin Exam Lobby"
        Height="820"
        Width="1240"
        MinHeight="680"
        MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="#D7E4EF">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0A315D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#061D38"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="#17395F"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="#17395F"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderBrush" Value="#17395F"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="RowHeight" Value="32"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#20252C" BorderBrush="#7E1825" BorderThickness="0,0,0,4" Padding="18,14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="MASTER ADMIN EXAM LOBBY" Foreground="#FFFFFF" FontSize="26" FontWeight="Bold" FontFamily="Tahoma"/>
                    <TextBlock Text="Secure desktop control panel for exam monitoring and authority workflow" Foreground="#92E0C9" FontSize="13" FontFamily="Tahoma" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock x:Name="HeaderStatusText" Text="LOCKED" Foreground="#FFD34D" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Tahoma"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Border x:Name="GatePanel" Width="580" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F7FBFF" BorderBrush="#17395F" BorderThickness="3" Padding="24">
                <StackPanel>
                    <TextBlock Text="Operator Gate" Foreground="#07192F" FontSize="28" FontWeight="Bold" FontFamily="Tahoma"/>
                    <TextBlock Text="Enter authorized operator credentials to open the control lobby." Foreground="#273B55" FontSize="14" Margin="0,8,0,22" TextWrapping="Wrap"/>
                    <TextBlock Text="ADMIN EMAIL" Foreground="#07192F" FontWeight="Bold" FontFamily="Tahoma"/>
                    <TextBox x:Name="EmailBox" Margin="0,6,0,14"/>
                    <TextBlock Text="ADMIN PASSWORD" Foreground="#07192F" FontWeight="Bold" FontFamily="Tahoma"/>
                    <PasswordBox x:Name="PasswordBox" Margin="0,6,0,18"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="UnlockButton" Content="Unlock Lobby" Click="UnlockClicked"/>
                        <Button Content="Clear" Click="ClearGateClicked" Margin="10,0,0,0" Background="#5C1520"/>
                    </StackPanel>
                    <Border BorderBrush="#7E1825" BorderThickness="2" Background="#FFF1F1" Padding="10" Margin="0,16,0,0" x:Name="GateErrorPanel" Visibility="Collapsed">
                        <TextBlock x:Name="GateErrorText" Foreground="#7E1825" FontWeight="Bold" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="Protected access is verified before opening any operator function." Foreground="#44546A" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid x:Name="DashboardPanel" Visibility="Collapsed" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="#F7FBFF" BorderBrush="#17395F" BorderThickness="2" Padding="14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Operations Snapshot" Foreground="#07192F" FontSize="22" FontWeight="Bold" FontFamily="Tahoma"/>
                            <TextBlock x:Name="SnapshotStatusText" Text="Waiting for refresh." Foreground="#273B55" FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="OpenAdminConsoleButton" Content="Open Exam Admin Console" Click="OpenAdminConsoleClicked" Margin="0,0,8,0"/>
                            <Button x:Name="OpenMasterConsoleButton" Content="Open Master Console" Click="OpenMasterConsoleClicked" Margin="0,0,8,0"/>
                            <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshClicked" Margin="0,0,8,0"/>
                            <Button Content="Lock" Click="LockClicked" Background="#5C1520"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <UniformGrid Grid.Row="1" Columns="7" Margin="0,14,0,14">
                    <Border Background="#FFFFFF" BorderBrush="#17395F" BorderThickness="2" Padding="12" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="EXAMS" FontWeight="Bold"/><TextBlock x:Name="ExamCountText" Text="0" FontSize="26" FontWeight="Bold"/></StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" BorderBrush="#17395F" BorderThickness="2" Padding="12" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="CANDIDATES" FontWeight="Bold"/><TextBlock x:Name="CandidateCountText" Text="0" FontSize="26" FontWeight="Bold"/></StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" BorderBrush="#17395F" BorderThickness="2" Padding="12" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="RESPONSES" FontWeight="Bold"/><TextBlock x:Name="ResponseCountText" Text="0" FontSize="26" FontWeight="Bold"/></StackPanel>
                    </Border>
                    <Border Background="#FFF8E5" BorderBrush="#17395F" BorderThickness="2" Padding="12" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="INCIDENTS" FontWeight="Bold"/><TextBlock x:Name="IncidentCountText" Text="0" FontSize="26" FontWeight="Bold"/></StackPanel>
                    </Border>
                    <Border Background="#E8FFF5" BorderBrush="#17395F" BorderThickness="2" Padding="12" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="ACTIVE NOW" FontWeight="Bold"/><TextBlock x:Name="ActiveSessionCountText" Text="0" FontSize="26" FontWeight="Bold"/></StackPanel>
                    </Border>
                    <Border Background="#FFF1F1" BorderBrush="#7E1825" BorderThickness="2" Padding="12" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="PENDING REQUESTS" FontWeight="Bold"/><TextBlock x:Name="PendingCountText" Text="0" FontSize="26" FontWeight="Bold"/></StackPanel>
                    </Border>
                    <Border Background="#E8FFF5" BorderBrush="#17395F" BorderThickness="2" Padding="12">
                        <StackPanel><TextBlock Text="ADMINS" FontWeight="Bold"/><TextBlock x:Name="AdminCountText" Text="-" FontSize="26" FontWeight="Bold"/></StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Desktop Admin Operations" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10" BorderBrush="#17395F" BorderThickness="2" FontWeight="Bold">
                        <UniformGrid Columns="5" Margin="8">
                            <Button Content="Exam Settings / Uploads" Click="OpenAdminConsoleClicked" Margin="4"/>
                            <Button Content="Database View" Click="OpenAdminConsoleClicked" Margin="4"/>
                            <Button Content="Response Center" Click="OpenAdminConsoleClicked" Margin="4"/>
                            <Button Content="Evaluation / Keys" Click="OpenAdminConsoleClicked" Margin="4"/>
                            <Button Content="Master Approvals" Click="OpenMasterConsoleClicked" Margin="4" Background="#5C1520"/>
                        </UniformGrid>
                    </GroupBox>

                    <GroupBox Header="Registered Exams" Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" BorderBrush="#17395F" BorderThickness="2" FontWeight="Bold">
                        <DataGrid x:Name="ExamsGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding ExamCode}" Width="120"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridCheckBoxColumn Header="Lobby" Binding="{Binding ExamLobbyEnabled}" Width="70"/>
                                <DataGridCheckBoxColumn Header="Launch" Binding="{Binding ExamLaunchEnabled}" Width="70"/>
                                <DataGridCheckBoxColumn Header="Paper" Binding="{Binding QuestionPaperUploaded}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Header="Interrupted / Flagged Candidate Sessions" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" BorderBrush="#17395F" BorderThickness="2" FontWeight="Bold">
                        <DataGrid x:Name="IncidentsGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Exam" Binding="{Binding ExamCode}" Width="100"/>
                                <DataGridTextColumn Header="Candidate" Binding="{Binding CandidateName}" Width="150"/>
                                <DataGridTextColumn Header="Reg ID" Binding="{Binding RegistrationId}" Width="130"/>
                                <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingSeconds}" Width="85"/>
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Header="Rejoin / Re-exam Requests" Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" BorderBrush="#17395F" BorderThickness="2" FontWeight="Bold">
                        <DataGrid x:Name="RequestsGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="Exam" Binding="{Binding ExamCode}" Width="100"/>
                                <DataGridTextColumn Header="Candidate" Binding="{Binding CandidateName}" Width="160"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Header="Desktop Server Monitor" Grid.Row="2" Grid.Column="1" BorderBrush="#17395F" BorderThickness="2" FontWeight="Bold">
                        <TabControl>
                            <TabItem Header="Active Sessions">
                                <DataGrid x:Name="ActiveSessionsGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Exam" Binding="{Binding ExamCode}" Width="90"/>
                                        <DataGridTextColumn Header="Candidate" Binding="{Binding CandidateName}" Width="140"/>
                                        <DataGridTextColumn Header="Reg ID" Binding="{Binding RegistrationId}" Width="125"/>
                                        <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingSeconds}" Width="85"/>
                                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="65"/>
                                        <DataGridTextColumn Header="Last Heartbeat" Binding="{Binding LastHeartbeatAt}" Width="150"/>
                                        <DataGridTextColumn Header="Log" Binding="{Binding InterruptionReason}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Admin Registry">
                                <DataGrid x:Name="AdminsGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding AdminName}" Width="150"/>
                                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220"/>
                                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="110"/>
                                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="70"/>
                                        <DataGridTextColumn Header="Service" Binding="{Binding ServiceAvailed}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Desktop Devices">
                                <DataGrid x:Name="DesktopDevicesGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Device Name" Binding="{Binding DeviceName}" Width="170"/>
                                        <DataGridTextColumn Header="Device ID" Binding="{Binding DeviceId}" Width="230"/>
                                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="70"/>
                                        <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenAt}" Width="155"/>
                                        <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt}" Width="155"/>
                                        <DataGridTextColumn Header="Revoked" Binding="{Binding RevokedAt}" Width="155"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </GroupBox>
                </Grid>

                <Border Grid.Row="3" Background="#20252C" BorderBrush="#17395F" BorderThickness="2" Padding="9" Margin="0,14,0,0">
                    <TextBlock x:Name="BottomStatusText" Text="Master lobby separated from candidate exam client." Foreground="#92E0C9" FontWeight="Bold"/>
                </Border>
            </Grid>

            <Grid x:Name="BrowserPanel" Visibility="Collapsed" Background="#D7E4EF" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#20252C" BorderBrush="#17395F" BorderThickness="2" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock x:Name="BrowserTitleText" Text="Protected Desktop Console" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="BrowserAddressText" Text="Desktop-only signed browser session" Foreground="#92E0C9" FontSize="12"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Back To Lobby" Click="CloseBrowserClicked" Margin="0,0,8,0"/>
                            <Button Content="Reload" Click="ReloadBrowserClicked" Margin="0,0,8,0"/>
                            <Button Content="Lock" Click="LockClicked" Background="#5C1520"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" BorderBrush="#17395F" BorderThickness="2,0,2,2" Background="#FFFFFF">
                    <wv2:WebView2 x:Name="ProtectedBrowser"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
